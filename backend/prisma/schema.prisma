generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum KycStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  REJECTED
}

enum WalletStatus {
  ACTIVE
  FROZEN
  CLOSED
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REVERSED
}

enum TransactionChannel {
  WALLET_DEPOSIT
  WALLET_WITHDRAWAL
  INTERNAL_TRANSFER
  BANK_TRANSFER
  AIRTIME
  DATA
  ELECTRICITY
  CABLE_TV
}

model User {
  id                 String   @id @default(cuid())
  fullName           String
  email              String   @unique
  phone              String   @unique
  passwordHash       String
  referralCode       String?  @unique
  referredBy         String?
  bvn                String?
  nin                String?
  isEmailVerified    Boolean  @default(false)
  isPhoneVerified    Boolean  @default(false)
  transactionPinHash String?
  kycStatus          KycStatus @default(NOT_STARTED)
  refreshTokenHash   String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  wallet             Wallet?
  transactions       Transaction[]
  beneficiaries      Beneficiary[]

  @@index([email])
  @@index([phone])
}

model Wallet {
  id            String       @id @default(cuid())
  userId        String       @unique
  accountNumber String       @unique
  currency      String       @default("NGN")
  balance       Decimal      @default(0.00) @db.Decimal(18, 2)
  ledgerBalance Decimal      @default(0.00) @db.Decimal(18, 2)
  status        WalletStatus @default(ACTIVE)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  Transaction[]

  @@index([accountNumber])
}

model Beneficiary {
  id            String   @id @default(cuid())
  userId        String
  accountNumber String
  accountName   String
  bankName      String   @default("Milean Pay")
  nickname      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, accountNumber])
  @@index([userId])
}

model Transaction {
  id               String             @id @default(cuid())
  userId           String
  walletId         String
  reference        String             @unique
  type             TransactionType
  channel          TransactionChannel
  status           TransactionStatus  @default(PENDING)
  amount           Decimal            @db.Decimal(18, 2)
  balanceBefore    Decimal            @db.Decimal(18, 2)
  balanceAfter     Decimal            @db.Decimal(18, 2)
  narration        String
  metadata         Json?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet           Wallet             @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([walletId, createdAt])
  @@index([reference])
}
