generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum KycStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  REJECTED
}

enum WalletStatus {
  ACTIVE
  FROZEN
  CLOSED
}

enum TransactionType {
  CREDIT
  DEBIT
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REVERSED
}

enum TransactionChannel {
  WALLET_DEPOSIT
  WALLET_WITHDRAWAL
  INTERNAL_TRANSFER
  BANK_TRANSFER
  AIRTIME
  DATA
  ELECTRICITY
  CABLE_TV
  INTERNET
  BETTING
  EDUCATION
  SAVINGS
  LOAN
  VIRTUAL_CARD
}

enum ProductCategory {
  AIRTIME
  DATA
  ELECTRICITY
  CABLE_TV
  INTERNET
  BETTING
  EDUCATION
}

enum BillPaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REVERSED
}

enum SavingsStatus {
  ACTIVE
  COMPLETED
  BROKEN
}

enum LoanStatus {
  PENDING
  APPROVED
  DECLINED
  DISBURSED
  REPAID
  DEFAULTED
}

enum VirtualCardStatus {
  ACTIVE
  FROZEN
  DELETED
}

enum NotificationType {
  PUSH
  EMAIL
  SMS
  IN_APP
}

model User {
  id                 String   @id @default(cuid())
  fullName           String
  email              String   @unique
  phone              String   @unique
  passwordHash       String
  referralCode       String?  @unique
  referredBy         String?
  bvn                String?
  nin                String?
  isEmailVerified    Boolean  @default(false)
  isPhoneVerified    Boolean  @default(false)
  transactionPinHash String?
  kycStatus          KycStatus @default(NOT_STARTED)
  refreshTokenHash   String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  wallet             Wallet?
  transactions       Transaction[]
  beneficiaries      Beneficiary[]
  billPayments       BillPayment[]
  savingsPlans       SavingsPlan[]
  loanApplications   LoanApplication[]
  virtualCards       VirtualCard[]
  notifications      Notification[]

  @@index([email])
  @@index([phone])
}

model Wallet {
  id            String       @id @default(cuid())
  userId        String       @unique
  accountNumber String       @unique
  currency      String       @default("NGN")
  balance       Decimal      @default(0.00) @db.Decimal(18, 2)
  ledgerBalance Decimal      @default(0.00) @db.Decimal(18, 2)
  status        WalletStatus @default(ACTIVE)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions  Transaction[]
  billPayments  BillPayment[]

  @@index([accountNumber])
}

model Beneficiary {
  id            String   @id @default(cuid())
  userId        String
  accountNumber String
  accountName   String
  bankName      String   @default("Milean Pay")
  nickname      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, accountNumber])
  @@index([userId])
}

model Transaction {
  id               String             @id @default(cuid())
  userId           String
  walletId         String
  reference        String             @unique
  type             TransactionType
  channel          TransactionChannel
  status           TransactionStatus  @default(PENDING)
  amount           Decimal            @db.Decimal(18, 2)
  balanceBefore    Decimal            @db.Decimal(18, 2)
  balanceAfter     Decimal            @db.Decimal(18, 2)
  narration        String
  metadata         Json?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  user             User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet           Wallet             @relation(fields: [walletId], references: [id], onDelete: Cascade)
  billPayment      BillPayment?

  @@index([userId, createdAt])
  @@index([walletId, createdAt])
  @@index([reference])
}


model BillPayment {
  id                String            @id @default(cuid())
  userId            String
  walletId          String
  transactionId     String?           @unique
  category          ProductCategory
  provider          String
  productCode       String
  customerReference String
  amount            Decimal           @db.Decimal(18, 2)
  status            BillPaymentStatus @default(PENDING)
  externalReference String?
  metadata          Json?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet            Wallet            @relation(fields: [walletId], references: [id], onDelete: Cascade)
  transaction       Transaction?      @relation(fields: [transactionId], references: [id])

  @@index([userId, createdAt])
  @@index([category, provider])
}

model SavingsPlan {
  id           String        @id @default(cuid())
  userId       String
  name         String
  targetAmount Decimal       @db.Decimal(18, 2)
  balance      Decimal       @default(0.00) @db.Decimal(18, 2)
  status       SavingsStatus @default(ACTIVE)
  maturityDate DateTime?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model LoanApplication {
  id              String     @id @default(cuid())
  userId          String
  requestedAmount Decimal    @db.Decimal(18, 2)
  approvedAmount  Decimal?   @db.Decimal(18, 2)
  tenorDays       Int
  purpose         String
  status          LoanStatus @default(PENDING)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  user            User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model VirtualCard {
  id          String            @id @default(cuid())
  userId      String
  label       String
  currency    String            @default("USD")
  maskedPan   String
  status      VirtualCardStatus @default(ACTIVE)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType @default(IN_APP)
  title     String
  message   String
  readAt    DateTime?
  createdAt DateTime         @default(now())
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}
